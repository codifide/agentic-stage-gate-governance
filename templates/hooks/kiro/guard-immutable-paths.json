{
  "version": "v1",
  "hooks": [
    {
      "name": "Guard immutable paths",
      "trigger": "PreToolUse",
      "matcher": "write|fs_write|str_replace|fs_append|delete_file|smart_relocate|semantic_rename",
      "action": {
        "type": "command",
        "command": "bash .codifide/guard-immutable-paths.sh || exit 2"
      }
    }
  ]
}
